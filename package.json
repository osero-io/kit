{
  "name": "osero-sdk",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "api:report:check": "node scripts/check-client-api.mjs",
    "api:report:write": "node scripts/check-client-api.mjs --write",
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "turbo run format:check lint build typecheck test",
    "ci:publish": "pnpm release:verify && changeset publish",
    "clean:client": "node scripts/clean-client-output.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "package:validate": "node scripts/validate-client-package.mjs",
    "release:prepare": "node scripts/prepare-changesets-release.mjs",
    "release:verify": "pnpm check && pnpm test:release && pnpm --filter @osero/client test:coverage && pnpm package:validate",
    "test": "turbo run test",
    "test:api-v1-contract": "node scripts/run-api-v1-contract-tests.mjs",
    "test:release": "node --test scripts/prepare-changesets-release.test.mjs",
    "typecheck": "turbo run typecheck",
    "typecheck:api-v1-contract": "node scripts/typecheck-api-v1-contract.mjs",
    "version-packages": "changeset version && node scripts/sync-client-version.mjs && oxfmt .changeset packages",
    "version-packages:stable": "changeset pre exit && changeset version && node scripts/sync-client-version.mjs && oxfmt .changeset packages"
  },
  "dependencies": {
    "neverthrow": "^8.2.0",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@privy-io/node": "^0.34.0",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "~4.1.0",
    "ethers": "^6.16.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.60.0",
    "tslib": "^2.3.0",
    "turbo": "^2.10.12",
    "typescript": "~7.0.2",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  },
  "packageManager": "pnpm@12.4.1"
}
