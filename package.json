{
  "name": "osero-sdk",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "changeset": "changeset",
    "version-packages": "changeset version && oxfmt .changeset packages",
    "version-packages:stable": "changeset pre exit && changeset version && oxfmt .changeset packages",
    "release:prepare": "node scripts/prepare-changesets-release.mjs",
    "clean:client": "node scripts/clean-client-output.mjs",
    "typecheck:api-v1-contract": "node scripts/typecheck-api-v1-contract.mjs",
    "test:api-v1-contract": "node scripts/run-api-v1-contract-tests.mjs",
    "api:report:check": "node scripts/check-client-api.mjs",
    "api:report:write": "node scripts/check-client-api.mjs --write",
    "package:validate": "node scripts/validate-client-package.mjs",
    "release:verify": "pnpm nx run-many -t format:check lint build typecheck test && pnpm --filter @osero/client test:coverage && pnpm package:validate",
    "ci:publish": "pnpm release:verify && changeset publish",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "neverthrow": "^8.2.0",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@nx/js": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@privy-io/node": "^0.28.0",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.15.47",
    "@swc/helpers": "0.5.23",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "~4.1.0",
    "ethers": "^6.16.0",
    "nx": "23.1.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.60.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "verdaccio": "^6.3.2",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  },
  "packageManager": "pnpm@10.30.3",
  "nx": {
    "includedScripts": [
      "lint",
      "lint:fix",
      "format",
      "format:check"
    ],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      },
      "lint": {
        "cache": true,
        "inputs": [
          "{workspaceRoot}/.oxlintrc.json",
          "{workspaceRoot}/*.{js,mjs,cjs,ts,tsx}",
          "{workspaceRoot}/.github/**/*.{js,mjs,cjs,ts,tsx}",
          "{workspaceRoot}/packages/**/*.{ts,tsx,js,mjs,cjs}",
          "{workspaceRoot}/examples/**/*.{ts,tsx,js,mjs,cjs}"
        ]
      },
      "format:check": {
        "cache": true,
        "inputs": [
          "{workspaceRoot}/.oxfmtrc.json",
          "{workspaceRoot}/*.{json,md,yml,yaml}",
          "{workspaceRoot}/.github/**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}",
          "{workspaceRoot}/packages/**/*.{ts,tsx,js,mjs,cjs,json,md}",
          "{workspaceRoot}/examples/**/*.{ts,tsx,js,mjs,cjs,json,md}"
        ]
      }
    }
  }
}
