{
  "name": "osero-sdk",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "turbo run format:check lint build typecheck test",
    "ci:publish": "turbo run build --filter='./packages/*' && pnpm -r --filter './packages/*' publish --access public --no-git-checks --provenance",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "neverthrow": "^8.2.0",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@privy-io/node": "^0.34.0",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "~4.1.0",
    "ethers": "^6.16.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.60.0",
    "tslib": "^2.3.0",
    "turbo": "^2.10.12",
    "typescript": "~7.0.2",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  },
  "packageManager": "pnpm@12.4.1"
}
