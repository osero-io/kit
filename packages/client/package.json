{
  "name": "@osero/client",
  "version": "1.0.0-next.3",
  "description": "Production TypeScript SDK for preparing and executing USDC, USDS, and sUSDS swaps",
  "keywords": [
    "defi",
    "ethers",
    "osero",
    "osero-sdk",
    "privy",
    "psm",
    "sky",
    "spark",
    "stablecoin",
    "susds",
    "usds",
    "viem"
  ],
  "homepage": "https://github.com/osero-io/kit/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/osero-io/kit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osero-io/kit.git",
    "directory": "packages/client"
  },
  "files": [
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "dist",
    "src",
    "!**/*.tsbuildinfo",
    "!**/*.test.ts",
    "!**/*.spec.ts",
    "!src/**/_testing.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "osero-sdk": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./actions": {
      "osero-sdk": "./src/lib/actions/index.ts",
      "types": "./dist/lib/actions/index.d.ts",
      "import": "./dist/lib/actions/index.js",
      "default": "./dist/lib/actions/index.js"
    },
    "./api": {
      "osero-sdk": "./src/api.ts",
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "default": "./dist/api.js"
    },
    "./contracts": {
      "osero-sdk": "./src/contracts.ts",
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    },
    "./viem": {
      "osero-sdk": "./src/viem.ts",
      "types": "./dist/viem.d.ts",
      "import": "./dist/viem.js",
      "default": "./dist/viem.js"
    },
    "./eip5792": {
      "osero-sdk": "./src/eip5792.ts",
      "types": "./dist/eip5792.d.ts",
      "import": "./dist/eip5792.js",
      "default": "./dist/eip5792.js"
    },
    "./ethers": {
      "osero-sdk": "./src/ethers.ts",
      "types": "./dist/ethers.d.ts",
      "import": "./dist/ethers.js",
      "default": "./dist/ethers.js"
    },
    "./privy": {
      "osero-sdk": "./src/privy.ts",
      "types": "./dist/privy.d.ts",
      "import": "./dist/privy.js",
      "default": "./dist/privy.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "test:coverage": "vitest --run --coverage",
    "test:fork": "vitest --config vitest.fork.config.mts --run"
  },
  "dependencies": {
    "neverthrow": "^8.2.0",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@privy-io/node": "^0.19.0 || ^0.28.0",
    "ethers": "^6.14.0",
    "viem": ">=2.28.0 <3"
  },
  "peerDependenciesMeta": {
    "@privy-io/node": {
      "optional": true
    },
    "ethers": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "nx": {
    "includedScripts": [
      "lint",
      "lint:fix",
      "format",
      "format:check"
    ],
    "targets": {
      "lint": {
        "cache": true,
        "inputs": [
          "{workspaceRoot}/.oxlintrc.json",
          "{projectRoot}/src/**/*.{ts,tsx}"
        ]
      },
      "format:check": {
        "cache": true,
        "inputs": [
          "{workspaceRoot}/.oxfmtrc.json",
          "{projectRoot}/src/**/*.{ts,tsx,json,md}"
        ]
      }
    }
  }
}
